# Environment Configuration Template for LoveMyFluffy.com
# Copy this file to .env and update with your actual values
#
# For staging (Manus): Use localhost URLs and debug mode
# For production (Mac mini): Use your domain and disable debug

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=lovemyfluffy
MYSQL_USER=wordpress
MYSQL_PASSWORD=your_secure_wordpress_db_password_here

# =============================================================================
# WORDPRESS CONFIGURATION
# =============================================================================

# WordPress URLs
# Staging example: http://localhost:8660
# Production example: https://lovemyfluffy.com
WORDPRESS_HOME=http://localhost:8660
WORDPRESS_SITEURL=http://localhost:8660

# WordPress Debug Mode
# Staging: true, Production: false
WORDPRESS_DEBUG=true
WORDPRESS_DEBUG_LOG=true
WORDPRESS_DEBUG_DISPLAY=false

# =============================================================================
# PORT CONFIGURATION
# =============================================================================

# WordPress port (default: 8660)
WORDPRESS_PORT=8660

# phpMyAdmin port (optional, default: 8661)
PHPMYADMIN_PORT=8661

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit the actual .env file to Git
# 2. Keep different .env files for staging and production
# 3. Use strong passwords for production
# 4. Update WORDPRESS_HOME and WORDPRESS_SITEURL for production domain
